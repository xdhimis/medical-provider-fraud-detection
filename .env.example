# Copy to .env and fill in values. Never commit .env.
# Auth: use ADC locally (`gcloud auth application-default login`)
# or Workload Identity Federation in GitHub Actions. Do not put SA JSON here.

GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

GCS_BUCKET=your-gcs-bucket
GCS_RAW_PREFIX=raw/train

BQ_DATASET_RAW=fraud_raw
BQ_DATASET_FEATURES=fraud_features
BQ_LOCATION=US

FEATURE_ONLINE_STORE=fraud_provider_store
FEATURE_VIEW=provider_fraud_features

MODEL_DISPLAY_NAME=provider-fraud-xgb
ENDPOINT_DISPLAY_NAME=provider-fraud-endpoint
ENDPOINT_MACHINE_TYPE=n1-standard-4
ENDPOINT_MIN_REPLICA_COUNT=1
ENDPOINT_MAX_REPLICA_COUNT=1

# Optional overrides (leave blank to auto-resolve from Model Registry / Endpoint).
# Use FULL Vertex resource names, not display names. Examples:
# MODEL_RESOURCE_NAME=projects/PROJECT_NUMBER/locations/us-central1/models/MODEL_ID
# ENDPOINT_RESOURCE_NAME=projects/PROJECT_NUMBER/locations/us-central1/endpoints/ENDPOINT_ID
# If MODEL_RESOURCE_NAME is set, register-model uploads as a new version of that parent.
MODEL_RESOURCE_NAME=
ENDPOINT_RESOURCE_NAME=

ARTIFACT_GCS_PREFIX=models
TRAIN_TEST_SIZE=0.2
TRAIN_RANDOM_SEED=42
# Leave blank to load from THRESHOLD_GCS_URI (train artifact) or default 0.5.
PREDICTION_THRESHOLD=
# e.g. gs://BUCKET/models/RUN_ID/threshold.json (or the RUN_ID directory)
THRESHOLD_GCS_URI=
# Optional digest pin; default is version-locked xgboost-cpu.2-1:latest
# XGBOOST_SERVING_IMAGE=us-docker.pkg.dev/vertex-ai/prediction/xgboost-cpu.2-1@sha256:...

LOG_LEVEL=INFO
